{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kir",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b80f9284-8099-4172-81c1-a2274df801a1","database_name": "atlas-path-rocket-1c659e-db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "fa1dd3f058544975b04a368394d46acc" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
